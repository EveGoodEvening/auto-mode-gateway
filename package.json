{
  "name": "auto-mode-proxy",
  "version": "0.1.0",
  "description": "A safety decision proxy for autonomous coding agents",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^24.11.0 || >=26.0.0",
    "npm": ">=12.0.0"
  },
  "bin": {
    "auto-mode-proxy": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "README*",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx watch src/cli/index.ts",
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "docs:check": "tsx scripts/check-docs.ts",
    "eval": "tsx src/cli/index.ts eval"
  },
  "allowScripts": {
    "@swc/core": false,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@inquirer/prompts": "8.7.5",
    "commander": "15.0.0",
    "eventsource-parser": "3.1.1",
    "hono": "4.13.14",
    "partial-json": "0.1.7",
    "pino": "10.4.0",
    "shell-quote": "1.12.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@swc/core": "1.16.20",
    "@types/node": "24.19.2",
    "@types/shell-quote": "1.7.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "tsup": "8.5.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
