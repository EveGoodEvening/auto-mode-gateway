# Copy to deploy/.env, chmod 0600, then replace every value below.
# Keep this file out of Git and the Docker build context; never put keys in YAML.
# Public production prerequisite: authorized DNS + inbound TCP 80/443 on this host.
# DOMAIN must be a hostname only (no scheme/path); public HTTPS is a separate gate.
DOMAIN=gateway.example.com
AMP_TOKEN_CC=replace-with-independent-random-client-token
AMP_TOKEN_CODEX=replace-with-independent-random-client-token
AMP_TOKEN_WORKBUDDY=replace-with-independent-random-client-token
AMP_ADMIN_TOKEN=replace-with-independent-random-admin-token
RELAY_A_KEY=replace-with-relay-a-key
RELAY_B_KEY=replace-with-relay-b-key
OPENROUTER_API_KEY=replace-with-openrouter-key
CF_ACCOUNT_ID=replace-with-cloudflare-account-id
CF_API_TOKEN=replace-with-cloudflare-api-token
CF_GATEWAY_ID=replace-with-cloudflare-gateway-id
AI_GATEWAY_API_KEY=replace-with-vercel-gateway-key
# Container-visible project identity; no host project directory is mounted.
PROJECT_DIR=/workspace/project
# Compose deliberately forces this path. Audit volume must be uid/gid 1000 writable.
AMP_AUDIT_PATH=/app/audit/audit.jsonl
